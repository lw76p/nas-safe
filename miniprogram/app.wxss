/* app.wxss — 全局深色仪表盘主题（与 Web UI 一致） */
page {
  --bg: #0e131c;
  --panel: #151c28;
  --panel-2: #1b2433;
  --line: #263244;
  --text: #e6edf3;
  --muted: #8b97a6;
  --accent: #2ecc71;       /* 翠绿：防勒索主色 */
  --blue: #4a9eff;         /* 存储/蓝 */
  --purple: #8b7bff;       /* 快照/靛紫 */
  --warn: #f5b041;
  --danger: #ff5c6c;
  background: var(--bg);
  color: var(--text);
  font-family: -apple-system, "PingFang SC", "Microsoft YaHei", sans-serif;
}

.card {
  background: var(--panel);
  border: 1px solid var(--line);
  border-radius: 16rpx;
  padding: 26rpx 28rpx;
  margin: 18rpx 24rpx;
}

.card-title {
  font-size: 28rpx;
  color: var(--muted);
  margin-bottom: 16rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 14rpx 0;
  font-size: 30rpx;
}

.row + .row {
  border-top: 1px solid var(--line);
}

.muted { color: var(--muted); font-size: 26rpx; }
.small { font-size: 24rpx; }

.badge {
  display: inline-block;
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  line-height: 1.6;
}
.badge.ok { color: var(--accent); background: rgba(46,204,113,.14); }
.badge.warn { color: var(--warn); background: rgba(245,176,65,.14); }
.badge.danger { color: var(--danger); background: rgba(255,92,108,.14); }
.badge.info { color: var(--blue); background: rgba(74,158,255,.14); }
.badge.muted { color: var(--muted); background: rgba(139,151,166,.14); }

.btn {
  border-radius: 14rpx;
  font-size: 30rpx;
  padding: 18rpx 0;
  text-align: center;
  border: 1px solid var(--line);
  background: var(--panel-2);
  color: var(--text);
}
.btn-primary {
  background: var(--accent);
  color: #06210f;
  font-weight: 600;
  border: none;
}
.btn-danger {
  background: var(--danger);
  color: #fff;
  border: none;
}
.btn-block { width: 100%; }
.btn[disabled] { opacity: .5; }

.bar {
  height: 14rpx;
  border-radius: 999rpx;
  background: var(--panel-2);
  overflow: hidden;
  margin-top: 12rpx;
}
.bar > view {
  height: 100%;
  background: var(--accent);
  border-radius: 999rpx;
}

.empty {
  text-align: center;
  color: var(--muted);
  padding: 80rpx 0;
  font-size: 28rpx;
}

.hint {
  font-size: 24rpx;
  color: var(--muted);
  margin: 8rpx 24rpx 24rpx;
  line-height: 1.6;
}
